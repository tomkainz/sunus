<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose does the styling; the Android theme only keeps the launch
         screen calm and hides the title bar. -->
    <style name="Theme.SonosLive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0B0D</item>
        <item name="android:statusBarColor">#0B0B0D</item>
        <item name="android:navigationBarColor">#0B0B0D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Only until the app is up: black with the logo. MainActivity switches
         to Theme.SonosLive in onCreate. -->
    <style name="Theme.SonosLive.Start">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
