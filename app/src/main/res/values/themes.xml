<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose uebernimmt das Styling; das Android-Theme haelt nur den
         Startbildschirm ruhig und blendet die Titelleiste aus. -->
    <style name="Theme.SonosLive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0B0D</item>
        <item name="android:statusBarColor">#0B0B0D</item>
        <item name="android:navigationBarColor">#0B0B0D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Nur bis die App steht: schwarz mit Logo. MainActivity wechselt in
         onCreate auf Theme.SonosLive. -->
    <style name="Theme.SonosLive.Start">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>
</resources>
