<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 12 the system draws the splash screen itself: the logo
         without its tile on black, instead of the icon on a grey background. -->
    <style name="Theme.SonosLive.Start">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
</resources>
