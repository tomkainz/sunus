<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonos only speaks unencrypted HTTP on port 1400, and the speaker fetches the
  stream from this phone over HTTP. Android 9 and newer block cleartext by
  default, so neither works without this exception.

  The config has no IP ranges (CIDR), only fixed host names, and the speaker's
  address is not known in advance. So cleartext is allowed in general. That is
  acceptable because the app only talks to devices on the local network and
  sends no data outside it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
